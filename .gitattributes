* text=auto eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.urdf text eol=lf
# Preserve byte-for-byte checksums recorded in the CAD provenance manifest.
*.obj binary
*.mtl binary
*.png binary
*.jpg binary
*.mp4 binary
*.stl binary

# Pinned vendor files retain upstream bytes and whitespace for hash verification.
eersim/_native/physx/include/** -text -whitespace
eersim/_native/physx/LICENSE.md -text -whitespace
docs/notices/PyOpenGL-3.1.10-license.txt -text -whitespace
