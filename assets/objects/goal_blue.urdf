<?xml version='1.0' encoding='utf-8'?>
<robot name="override_goal_blue">
  <link name="goal" concave="yes">
    <inertial>
      <mass value="0" />
      <inertia ixx="0" iyy="0" izz="0" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="../meshes/override/goal_alliance.obj" />
      </geometry>
      <material name=".._meshes_override_goal_alliance.obj">
        <color rgba=".02 .48 .83 1" />
      </material>
    </visual>
    <collision concave="yes">
      <geometry>
        <mesh filename="goal_socket_collision.obj" />
      </geometry>
      <origin xyz="0 0 0" />
    </collision>
    <collision>
      <origin xyz="0 0 -.002" />
      <geometry>
        <box size=".300 .300 .004" />
      </geometry>
    </collision>
  </link>
</robot>